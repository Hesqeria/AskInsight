# ===== Intelligent Data-Query Environment Configuration Template =====
# Copy to .env and fill in your real configuration

# LLM
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=http://127.0.0.1:8000/v1

# Embedding
EMBEDDING_API_KEY=your-embedding-api-key

# Doris
DORIS_HOST=127.0.0.1
DORIS_PORT=9030
DORIS_USER=root
DORIS_PASSWORD=your-doris-password
DORIS_DATABASE=dw

# Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=your-milvus-password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=app
PG_PASSWORD=your-pg-password
PG_DATABASE=app

# Kafka (optional)
KAFKA_BOOTSTRAP=127.0.0.1:9092

# Superset (optional)
SUPERSET_URL=http://127.0.0.1:8088
SUPERSET_USER=admin
SUPERSET_PASSWORD=admin

# JWT
JWT_SECRET=your-jwt-secret-change-me
ADMIN_PASSWORD=your-admin-password

# API authentication (for MCP server)
API_USER=admin
API_PASSWORD=your-admin-password
