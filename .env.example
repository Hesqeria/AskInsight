# AskInsight Environment Configuration
# Copy this file to .env and fill in your values

# Authentication
JWT_SECRET=change-me-to-a-random-string
ADMIN_PASSWORD=change-me

# Database - Doris (data warehouse)
DORIS_HOST=
DORIS_PASSWORD=

# Database - PostgreSQL (business)
PG_HOST=
PG_PASSWORD=

# Database - MySQL (legacy)
MYSQL_HOST=
MYSQL_PASSWORD=

# Vector Store - Milvus
MILVUS_HOST=
MILVUS_PASSWORD=

# Cache/Session - Redis
REDIS_HOST=
REDIS_PASSWORD=

# LLM
LLM_API_KEY=
LLM_MODEL_NAME=
LLM_BASE_URL=

# Embedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# BI - Superset
SUPERSET_URL=
SUPERSET_USER=
SUPERSET_PASSWORD=

# Message Queue - Kafka
KAFKA_BOOTSTRAP=
KAFKA_TOPIC=
